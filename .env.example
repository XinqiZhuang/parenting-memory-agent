# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Feishu application
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional chat allowlist (one family only); comma-separated IDs
FEISHU_ALLOWED_CHAT_IDS=
# Optional user allowlist; comma-separated IDs
FEISHU_ALLOWED_USER_IDS=

# Runtime data directory
# Local development: data
# Cloud persistent volume: /data
PARENTING_DATA_DIR=data
