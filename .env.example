# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Feishu application
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional chat allowlist (one family only); comma-separated IDs
FEISHU_ALLOWED_CHAT_IDS=
# Optional user allowlist; comma-separated IDs
FEISHU_ALLOWED_USER_IDS=

# Runtime data directory
# Local development: data
# Cloud persistent volume: /data
PARENTING_DATA_DIR=data

# V3: independent image-capable, OpenAI-compatible Chat Completions endpoint
# No key or image is sent until the user explicitly requests photo recognition.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Family web password; production requires at least 16 characters
APP_ENV=local
WEB_PASSWORD=

# Must exactly match the Feishu bot's display name (or specify its open_id)
FEISHU_BOT_NAME=育儿助手Agent
FEISHU_BOT_OPEN_ID=
# Optional initial push target; must also be in FEISHU_ALLOWED_CHAT_IDS
FEISHU_PUSH_CHAT_ID=
